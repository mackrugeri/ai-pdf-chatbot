# Copy to .streamlit/secrets.toml and set a private cookie secret/client secret.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace_with_a_random_64_character_secret"
client_id = "aipdf-streamlit-local"
client_secret = "replace_with_KEYCLOAK_STREAMLIT_CLIENT_SECRET_from_.env"
server_metadata_url = "http://localhost:8080/realms/ai-pdf-chatbot/.well-known/openid-configuration"
client_kwargs = { scope = "openid profile email roles" }
expose_tokens = ["access"]

[api]
base_url = "http://localhost:8000"
