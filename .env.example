# Local development only. Copy to .env; never commit the real .env.
# Use distinct random passwords with letters, digits, _ and - so connection URLs
# remain valid without extra percent-encoding. These examples are NOT production secrets.
POSTGRES_USER=aipdf
POSTGRES_DB=aipdf
POSTGRES_PASSWORD=replace_with_random_postgres_password
REDIS_PASSWORD=replace_with_random_redis_password
RABBITMQ_USER=aipdf
RABBITMQ_VHOST=aipdf
RABBITMQ_PASSWORD=replace_with_random_rabbitmq_password

# API/model configuration; runtime model adapters are not implemented yet.
APP_ENV=development
MODEL_BACKEND=fake
# Host-run API uses localhost. Container model URLs are configured separately below.
OLLAMA_GENERATION_URL=http://localhost:11434
OLLAMA_QUERY_EMBEDDING_URL=http://localhost:11434
OLLAMA_INGESTION_EMBEDDING_URL=http://localhost:11434

# Optional host port overrides: API_PORT, POSTGRES_PORT, REDIS_PORT, RABBITMQ_PORT, KEYCLOAK_PORT,
# RABBITMQ_MANAGEMENT_PORT, CHROMA_PORT, OLLAMA_PORT.
# Optional image overrides: POSTGRES_IMAGE, REDIS_IMAGE, RABBITMQ_IMAGE,
# CHROMA_IMAGE, OLLAMA_IMAGE (default images are digest-pinned in compose.yaml).

# Host-run PostgreSQL client settings (Compose overrides the hostname internally).
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_TIMEOUT_SECONDS=10

# Host RabbitMQ connection; Compose uses its internal rabbitmq hostname.
BROKER_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:5672/${RABBITMQ_VHOST}
BROKER_CONNECT_TIMEOUT_SECONDS=5
BROKER_HEARTBEAT_SECONDS=30
WORKER_PREFETCH_COUNT=1
JOB_MAX_RETRIES=3
INGESTION_QUEUE=ingestion
ANSWER_QUEUE=answers
CLEANUP_QUEUE=cleanup

# Host Redis connection; Compose overrides it with the redis service hostname.
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5

# Model identities and resource budgets; these settings never download models.
GENERATION_MODEL=qwen3:4b
EMBEDDING_MODEL=nomic-embed-text
MODEL_TIMEOUT_SECONDS=180
MODEL_MAX_CONCURRENCY=1
MODEL_CONTEXT_TOKENS=8192
MODEL_MAX_OUTPUT_TOKENS=1024
# Container clients use these overrides; change to http://ollama:11434 for models profile.
DOCKER_OLLAMA_GENERATION_URL=http://host.docker.internal:11434
DOCKER_OLLAMA_QUERY_EMBEDDING_URL=http://host.docker.internal:11434
DOCKER_OLLAMA_INGESTION_EMBEDDING_URL=http://host.docker.internal:11434

# Local Keycloak uses a host issuer in tokens. Compose overrides JWKS to its service DNS.
OIDC_ISSUER=http://localhost:8080/realms/ai-pdf-chatbot
OIDC_AUDIENCE=pdf-api
OIDC_JWKS_URL=http://localhost:8080/realms/ai-pdf-chatbot/protocol/openid-connect/certs
OIDC_ALLOWED_ALGORITHMS=["RS256"]
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_JWKS_CACHE_TTL_SECONDS=300
OIDC_HTTP_TIMEOUT_SECONDS=5
OIDC_MAX_TOKEN_BYTES=16384
OIDC_JWKS_MAX_KEYS=100
OIDC_UNKNOWN_KID_REFRESH_SECONDS=5

# Local-only Keycloak bootstrap and imported demo account. Set separate random values.
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_random_local_keycloak_admin_password
KEYCLOAK_STREAMLIT_CLIENT_SECRET=replace_with_random_local_streamlit_client_secret
KEYCLOAK_DEMO_PASSWORD=replace_with_random_local_demo_password
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_PORT=8080

# Host-side vector service. Compose always uses chroma:8000 internally.
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_AUTH_TOKEN=
CHROMA_TIMEOUT_SECONDS=10

# Fill endpoint + bucket together when storage is added. Key pairs are optional
# for future workload identity, but if supplied both access and secret are required.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_TIMEOUT_SECONDS=10
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300
DELETION_JOURNAL_ENDPOINT=
DELETION_JOURNAL_BUCKET=
DELETION_JOURNAL_ACCESS_KEY=
DELETION_JOURNAL_SECRET_KEY=
# Operator assertion only: actual account/retention independence needs verification.
DELETION_JOURNAL_INDEPENDENT=false
# If host endpoints use localhost, provide container-reachable overrides here.
DOCKER_OBJECT_STORAGE_ENDPOINT=
DOCKER_DELETION_JOURNAL_ENDPOINT=
